# ── Server ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ── Database ──────────────────────────────────────────────────────────────
# Local: mongodb://127.0.0.1:27017/spydev
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/spydev
MONGO_URI=mongodb://127.0.0.1:27017/spydev

# ── Auth / JWT ────────────────────────────────────────────────────────────
# Generate strong random secrets, e.g.: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_DOMAIN=localhost

# ── Media storage (Cloudinary) ───────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email (SMTP) — optional; contact form/lead notifications no-op if unset
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SpyDev <no-reply@spydev.agency>"
NOTIFY_EMAIL=

# ── Initial Super Admin (used by `npm run seed`) ─────────────────────────
SEED_ADMIN_NAME="SpyDev Admin"
SEED_ADMIN_EMAIL=admin@spydev.agency
SEED_ADMIN_PASSWORD=ChangeMe_StrongPassword123!

# ── Rate limiting ─────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
